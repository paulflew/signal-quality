<Project Sdk="Microsoft.NET.Sdk">

  <!-- Console harness. With the offline flag (see CONTRIBUTING.md) it runs only the
       checks that need no network, which is what CI runs. With no flag it also makes
       real web checks, and with a folder argument it writes a contact sheet of every
       tray icon to that folder. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>Tests</AssemblyName>
    <RootNamespace>SignalQuality</RootNamespace>
    <LangVersion>5</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <StartupObject>SignalQuality.Tests</StartupObject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\src\SignalQuality.cs" />
    <Compile Include="Tests.cs" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

</Project>
